{
  "schemaVersion": 1,
  "id": "chatbabel",
  "version": "${version}",
  "name": "ChatBabel",
  "description": "Automatically detects and translates chat messages (and optionally the scoreboard, boss bar, title, subtitle and action bar), with hover-to-see-original/translated tooltips, acronym expansion, obfuscated-text reveal and Caesar cipher decoding.",
  "authors": [
    "Verschillend"
  ],
  "contact": {
    "homepage": "https://github.com/Verschillend/chatbabel",
    "issues": "https://github.com/Verschillend/chatbabel/issues",
    "sources": "https://github.com/Verschillend/chatbabel",
    "donate": "https://patreon.com/Verschillend?utm_medium=unknown&utm_source=join_link&utm_campaign=creatorshare_creator&utm_content=copyLink"
  },
  "license": "Vers (see LICENSE.txt in the mod/JAR)",
  "environment": "client",
  "entrypoints": {
    "client": [
      "me.verschillend.chatbabel.ChatBabelClient"
    ],
    "modmenu": [
      "me.verschillend.chatbabel.integration.ModMenuIntegration"
    ]
  },
  "mixins": [
    "chatbabel.mixins.json",
    "chatbabel.mixins.optional.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.4",
    "fabric-api": "*",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "cloth-config2": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
